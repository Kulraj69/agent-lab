diff --git a/tests/test_gate_coverage.py b/tests/test_gate_coverage.py
new file mode 100644
index 0000000..b284022
--- /dev/null
+++ b/tests/test_gate_coverage.py
@@ -0,0 +1,14 @@
+import unittest
+from teval.gate import check
+from teval.harness import RunResult, TrajectoryResult
+from teval.graders import Grade
+
+class CoverageTests(unittest.TestCase):
+    def result(self, ids=('a',), grades=('quality',)):
+        return RunResult([TrajectoryResult(t, [Grade(g, 1, []) for g in grades]) for t in ids])
+    def test_missing_trajectory_fails(self): self.assertFalse(check(self.result(()), {'a':{'quality':1}}).ok)
+    def test_missing_grader_fails(self): self.assertFalse(check(self.result(grades=()), {'a':{'quality':1}}).ok)
+    def test_duplicate_trajectory_fails(self): self.assertFalse(check(self.result(('a','a')), {'a':{'quality':1}}).ok)
+    def test_duplicate_grader_fails(self): self.assertFalse(check(self.result(grades=('quality','quality')), {'a':{'quality':1}}).ok)
+    def test_full_coverage_passes(self): self.assertTrue(check(self.result(), {'a':{'quality':1}}).ok)
+    def test_additional_trajectory_allowed(self): self.assertTrue(check(self.result(('a','b')), {'a':{'quality':1}}).ok)
diff --git a/tests/test_schema_tool_calls.py b/tests/test_schema_tool_calls.py
new file mode 100644
index 0000000..91f6489
--- /dev/null
+++ b/tests/test_schema_tool_calls.py
@@ -0,0 +1,22 @@
+import unittest
+from teval.schema import SchemaError, Step
+
+class ToolCallShapeTests(unittest.TestCase):
+    def test_missing_call_fails(self):
+        with self.assertRaises(SchemaError): Step.from_dict({'kind':'tool_call'})
+    def test_null_call_fails(self):
+        with self.assertRaises(SchemaError): Step.from_dict({'kind':'tool_call','tool_call':None})
+    def test_empty_name_fails(self):
+        with self.assertRaises(SchemaError): Step.from_dict({'kind':'tool_call','tool_call':{'name':''}})
+    def test_blank_name_fails(self):
+        with self.assertRaises(SchemaError): Step.from_dict({'kind':'tool_call','tool_call':{'name':'  '}})
+    def test_non_object_arguments_fail(self):
+        for args in (None,[],False,0,'bad'):
+            with self.subTest(args=args), self.assertRaises(SchemaError):
+                Step.from_dict({'kind':'tool_call','tool_call':{'name':'calc','arguments':args}})
+    def test_omitted_arguments_default_empty(self):
+        self.assertEqual(Step.from_dict({'kind':'tool_call','tool_call':{'name':'calc'}}).tool_call.arguments,{})
+    def test_valid_arguments_retained(self):
+        self.assertEqual(Step.from_dict({'kind':'tool_call','tool_call':{'name':'calc','arguments':{'x':2}}}).tool_call.arguments,{'x':2})
+    def test_ordinary_thought_does_not_need_call(self):
+        self.assertIsNone(Step.from_dict({'kind':'thought'}).tool_call)
