index 0000000..9895d2c
--- /dev/null
+++ b/tests/test_promotion_safety.py
@@ -0,0 +1,62 @@
+import copy
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+from flywheel.promote import promote
+from flywheel.store import append_feedback
+
+
+def trace(tid='a'):
+    return {'id':tid, 'steps':[{'kind':'tool_call','tool_call':{'name':'calc','arguments':{}}}],
+            'final_answer':'ok [tool:calc]', 'metadata':{'eval':{'allowed_tools':['calc']}}}
+
+class PromotionSafetyTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp=tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
+        self.pool=Path(self.tmp.name)/'pool.jsonl'; self.golden=Path(self.tmp.name)/'golden.jsonl'; self.fb=Path(self.tmp.name)/'feedback.jsonl'
+        self.write(self.pool,[trace()]); append_feedback(str(self.fb),'a',5,reviewer='synthetic-fixture')
+    def write(self,path,records): path.write_text(''.join(json.dumps(x)+'\n' for x in records))
+    def run_promotion(self,**kw): return promote(str(self.fb),str(self.pool),str(self.golden),**kw)
+    def test_duplicate_pool_rejected(self):
+        self.write(self.pool,[trace(),trace()])
+        with self.assertRaises(ValueError): self.run_promotion()
+        self.assertFalse(self.golden.exists())
+    def test_duplicate_golden_rejected(self):
+        self.write(self.golden,[trace(),trace()]); before=self.golden.read_bytes()
+        with self.assertRaises(ValueError): self.run_promotion()
+        self.assertEqual(before,self.golden.read_bytes())
+    def test_idempotent_bytes(self):
+        self.run_promotion(); before=self.golden.read_bytes(); result=self.run_promotion()
+        self.assertEqual(result['skipped'],['a']); self.assertEqual(result['promoted'],[])
+        self.assertEqual(before,self.golden.read_bytes())
+    def test_explicit_policy_wins(self):
+        self.assertEqual(self.run_promotion(config={'allowed_tools':['notes']})['promoted'],[])
+    def test_invalid_existing_golden_fails(self):
+        bad=trace('old'); bad['steps']=[]; self.write(self.golden,[bad]); before=self.golden.read_bytes()
+        with self.assertRaises(ValueError): self.run_promotion()
+        self.assertEqual(before,self.golden.read_bytes())
+    def test_atomic_replace_failure_preserves_existing(self):
+        self.write(self.golden,[])
+        with patch('flywheel.promote.os.replace',side_effect=OSError('simulated replacement failure')):
+            with self.assertRaises(OSError): self.run_promotion()
+        self.assertEqual(self.golden.read_bytes(),b'')
+        self.assertEqual(list(Path(self.tmp.name).glob('.golden-*')),[])
+    def test_lower_latest_rating_not_promoted(self):
+        append_feedback(str(self.fb),'a',1); self.assertEqual(self.run_promotion()['promoted'],[])
+    def test_missing_candidate_rejected(self):
+        self.write(self.pool,[]); self.assertIn('a',self.run_promotion()['rejected'])
+    def test_high_rating_does_not_bypass_gate(self):
+        bad=trace(); bad['steps']=[]; self.write(self.pool,[bad]); self.assertIn('a',self.run_promotion()['rejected'])
+    def test_correction_does_not_bypass_policy(self):
+        append_feedback(str(self.fb),'a',5,correction='ok [tool:calc]')
+        self.assertEqual(self.run_promotion(config={'allowed_tools':['notes']})['promoted'],[])
+    def test_bad_schema_leaves_golden_unchanged(self):
+        self.write(self.golden,[]); bad=trace(); bad['steps']=[{'kind':'tool_call'}]; self.write(self.pool,[bad])
+        with self.assertRaises(ValueError): self.run_promotion()
+        self.assertEqual(self.golden.read_bytes(),b'')
+    def test_valid_existing_and_new_preserved(self):
+        self.write(self.golden,[trace('old')]); result=self.run_promotion()
+        self.assertEqual(result['golden_size'],2); self.assertEqual(result['promoted'],['a'])
